{
  "schema_version": 1,
  "adapter": "codex-lifecycle-hooks",
  "scope": "Executable synthetic sequences for the retired Codex procedural interlock, unregistered and kept for rollback. This is not a cross-host conformance claim and does not prove semantic correctness.",
  "vocabulary": {
    "setups": ["clean", "configured", "agreed", "armed-test-digest"],
    "events": ["prompt", "prompt-transcript", "receipt", "raw-receipt", "pre", "post", "stop", "interrupt", "mkdir-task", "write-plan", "write-verification", "write-permissions", "write-impact", "remove-impact"],
    "decisions": ["control", "deny", "block", "silent"]
  },
  "sequences": [
    {
      "id": "AO-101",
      "class": "orientation",
      "claim": "Starting identified work with no pointer asks for one PMNM folder.",
      "setup": "clean",
      "events": [
        {"event": "prompt", "turn": "t1", "text": "Investigate TASK-101"},
        {"event": "receipt", "turn": "t1", "command": "pmnm-guard start task=TASK-101 effort=standard work=implementation"}
      ],
      "expect": {"decision": "control", "phase": "INVESTIGATE", "contains": "PMNM needs one folder"}
    },
    {
      "id": "AO-102",
      "class": "folder-bootstrap",
      "claim": "The one folder answer creates the pointer and advances to the project-name question.",
      "setup": "clean",
      "events": [
        {"event": "prompt", "turn": "t1", "text": "Investigate TASK-101"},
        {"event": "receipt", "turn": "t1", "command": "pmnm-guard start task=TASK-101 effort=standard work=implementation"},
        {"event": "prompt", "turn": "t2", "text": "Use that folder"},
        {"event": "receipt", "turn": "t2", "command": "pmnm-guard folder path=$FOLDER"}
      ],
      "expect": {"decision": "control", "phase": "INVESTIGATE", "contains": "no project folder"}
    },
    {
      "id": "AO-103",
      "class": "project-bootstrap",
      "claim": "Registering a project creates its stable mapping and points to the task-folder action.",
      "setup": "configured",
      "events": [
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard start task=TASK-101 effort=standard work=implementation"}
      ],
      "expect": {"decision": "control", "phase": "INVESTIGATE", "contains": "has no folder yet"}
    },
    {
      "id": "AO-104",
      "class": "digest-gate",
      "claim": "A project implementation write cannot begin before the human agrees to the plan Digest.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "pre", "turn": "t3", "tool": "apply_patch", "command": "$PATCH", "id": "write"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "pmnm-guard digest"}
    },
    {
      "id": "AO-105",
      "class": "sensitive-effect",
      "claim": "A sensitive command receives one exact later-turn permission action.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-plan", "turn": "t3", "text": "- [x] obsolete.txt — remove the obsolete artifact\n"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard digest"},
        {"event": "prompt", "turn": "t4", "text": "Agreed exactly as shown"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard agreed"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "rm obsolete.txt", "id": "delete"}
      ],
      "expect": {"decision": "deny", "phase": "READY", "contains": "pmnm-guard allow effect=deletion"}
    },
    {
      "id": "AO-106",
      "class": "unknown-effect",
      "claim": "An ordinary command names one explicit effect declaration as the sole next action.",
      "setup": "configured",
      "events": [
        {"event": "pre", "turn": "t3", "tool": "Bash", "command": "mystery-tool inspect", "id": "unknown"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "pmnm-guard declare effect="}
    },
    {
      "id": "AO-107",
      "class": "missing-result",
      "claim": "Stop preserves an in-flight operation whose host result never arrived.",
      "setup": "agreed",
      "events": [
        {"event": "pre", "turn": "t4", "tool": "apply_patch", "command": "$PATCH", "id": "write"},
        {"event": "stop", "turn": "t4"}
      ],
      "expect": {"decision": "block", "phase": "READY", "contains": "pmnm-guard result outcome="}
    },
    {
      "id": "AO-108",
      "class": "verification-close",
      "claim": "Observed implementation, current verification, and audit can close the task.",
      "setup": "agreed",
      "events": [
        {"event": "pre", "turn": "t4", "tool": "apply_patch", "command": "$PATCH", "id": "write"},
        {"event": "post", "turn": "t4", "tool": "apply_patch", "command": "$PATCH", "id": "write"},
        {"event": "write-verification", "turn": "t4"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard verified result=passed how=inspection"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard done audit=passed"},
        {"event": "stop", "turn": "t4", "text": "Test — TASK-101\nWhere: local interface\nEnvironment: isolated fixture\nAs: bounded test actor\nData: deterministic safe fixture\nSteps: 1. arrange 2. act 3. observe\nExpect: requested behavior changes and preserved behavior remains\nEvidence: retain the observed result\nCleanup: remove temporary fixture\nCan run: yes, with the fixture check"},
        {"event": "prompt", "turn": "t5", "text": "The Test Digest is clear; continue to the audit"},
        {"event": "receipt", "turn": "t5", "command": "pmnm-guard done audit=passed"}
      ],
      "expect": {"decision": "control", "phase": "COMPLETE", "contains": "closed, audit passed"}
    },
    {
      "id": "AO-109",
      "class": "recovery",
      "claim": "Interrupting an in-flight implementation preserves it in recovery.",
      "setup": "agreed",
      "events": [
        {"event": "pre", "turn": "t4", "tool": "apply_patch", "command": "$PATCH", "id": "write"},
        {"event": "interrupt", "turn": "t4"}
      ],
      "expect": {"decision": "silent", "phase": "RECOVERY"}
    },
    {
      "id": "AO-110",
      "class": "compatibility-alias",
      "claim": "The checkpoint alias executes the Digest transition while emitting only the current operational card.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-plan", "turn": "t3", "text": "- [x] example.txt — exercise the compatibility alias\n"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard checkpoint kind=combined basis=1"}
      ],
      "expect": {"decision": "control", "phase": "AWAITING_HUMAN", "contains": "waiting for the human", "forbid": "accepted as digest"}
    },
    {
      "id": "AO-111",
      "class": "external-deletion",
      "claim": "An external-only deletion asks for exact deletion authority without inventing a project Digest.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "rm $EXTERNAL", "id": "external-delete"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "pmnm-guard allow effect=deletion", "forbid": "Digest"}
    },
    {
      "id": "AO-112",
      "class": "compound-effect",
      "claim": "An unknown segment cannot borrow authority from a neighboring sensitive command.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "rm $EXTERNAL && mystery-tool act", "id": "compound"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "split", "forbid": "pmnm-guard allow"}
    },
    {
      "id": "AO-113",
      "class": "verification-close",
      "claim": "A passed audit cannot close a task without current passed verification.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-verification", "turn": "t4"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard done audit=passed", "id": "done-without-verification"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "verif"}
    },
    {
      "id": "AO-114",
      "class": "human-verification",
      "claim": "Human verification cannot be self-recorded before a later human turn.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-verification", "turn": "t4"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard verified result=passed how=human", "id": "same-turn-human-verification"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "human"}
    },
    {
      "id": "AO-115",
      "class": "host-plugin-effect",
      "claim": "A documented host plugin change follows the exact environment-authority path.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "codex plugin marketplace add ./source", "id": "plugin-marketplace-add"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "pmnm-guard allow effect=environment", "forbid": "classify effect="}
    },
    {
      "id": "AO-116",
      "class": "external-effect-verification",
      "claim": "A successful external or system effect cannot end before current verification.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "codex plugin marketplace add ./source", "id": "external-effect"},
        {"event": "prompt", "turn": "t5", "text": "$APPROVAL_TOKEN"},
        {"event": "receipt", "turn": "t5", "command": "pmnm-guard allow effect=environment", "id": "allow-external-effect"},
        {"event": "pre", "turn": "t5", "tool": "Bash", "command": "codex plugin marketplace add ./source", "id": "external-effect-retry"},
        {"event": "post", "turn": "t5", "tool": "Bash", "command": "codex plugin marketplace add ./source", "id": "external-effect-retry"},
        {"event": "stop", "turn": "t5"}
      ],
      "expect": {"decision": "block", "phase": "IMPLEMENT", "contains": "unverified"}
    },
    {
      "id": "AO-117",
      "class": "permission-forecast",
      "claim": "One agreed task forecast admits the same exact sensitive operation more than once without another PMNM question.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-plan", "turn": "t3", "text": "- [x] example.txt — exercise forecasted authority\n"},
        {"event": "write-permissions", "turn": "t3", "value": {"task": [{"effect": "environment", "tool": "Bash", "input": {"command": "codex plugin marketplace add ./fixture"}, "reason": "exercise a deterministic local fixture"}]}},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard digest"},
        {"event": "prompt", "turn": "t4", "text": "Agreed exactly as shown"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard agreed"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "codex plugin marketplace add ./fixture", "id": "forecast-one"},
        {"event": "post", "turn": "t4", "tool": "Bash", "command": "codex plugin marketplace add ./fixture", "id": "forecast-one"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "codex plugin marketplace add ./fixture", "id": "forecast-two"},
        {"event": "post", "turn": "t4", "tool": "Bash", "command": "codex plugin marketplace add ./fixture", "id": "forecast-two"}
      ],
      "expect": {"decision": "silent", "phase": "IMPLEMENT"}
    },
    {
      "id": "AO-118",
      "class": "dynamic-effect",
      "claim": "An ordinary command proceeds only after one exact structured declaration, without receiving authority from its executable name.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "pre", "turn": "t3", "tool": "Bash", "command": "new-tool inspect --format=json", "id": "dynamic-first"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard declare effect=investigation boundary=project persistence=none certainty=certain capability=none", "id": "dynamic-declare"},
        {"event": "pre", "turn": "t3", "tool": "Bash", "command": "new-tool inspect --format=json", "id": "dynamic-retry"}
      ],
      "expect": {"decision": "silent", "phase": "INVESTIGATE"}
    },
    {
      "id": "AO-119",
      "class": "impact-preflight",
      "claim": "A Standard implementation Digest cannot proceed without the canonical impact contract.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-plan", "turn": "t3", "text": "- [ ] example.txt — exercise impact preflight\n"},
        {"event": "remove-impact"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard digest", "id": "digest-without-impact"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "impact"}
    },
    {
      "id": "AO-120",
      "class": "transitive-impact",
      "claim": "An unresolved blocking node cannot be hidden by a complete plan and verification contract.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-plan", "turn": "t3", "text": "- [ ] example.txt — exercise transitive impact\n"},
        {"event": "write-impact", "turn": "t3", "mode": "transitive-unresolved", "id": "unresolved-impact"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard digest", "id": "digest-with-unresolved-impact"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "blocking impact unresolved"}
    },
    {
      "id": "AO-121",
      "class": "impact-drift",
      "claim": "A material impact-contract change after agreement withdraws implementation authority.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-plan", "turn": "t3", "text": "- [ ] example.txt — exercise impact binding\n"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard digest"},
        {"event": "prompt", "turn": "t4", "text": "Agreed exactly as shown"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard agreed"},
        {"event": "write-impact", "turn": "t4", "reason": "A materially different root now applies.", "id": "changed-impact"},
        {"event": "pre", "turn": "t4", "tool": "apply_patch", "command": "$PATCH", "id": "write-after-impact-drift"}
      ],
      "expect": {"decision": "deny", "phase": "READY", "contains": "Agreed impact changed"}
    },
    {
      "id": "AO-122",
      "class": "same-task-in-flight",
      "claim": "Restarting the selected task cannot erase an admitted operation whose host result has not arrived.",
      "setup": "agreed",
      "events": [
        {"event": "pre", "turn": "t4", "tool": "apply_patch", "command": "$PATCH", "id": "in-flight"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard start task=TASK-101 effort=standard work=implementation", "id": "restart-in-flight"}
      ],
      "expect": {"decision": "deny", "phase": "READY", "contains": "host reported no result"}
    },
    {
      "id": "AO-123",
      "class": "final-impact-closure",
      "claim": "A passed audit cannot close while the final impact omission audit is stale.",
      "setup": "agreed",
      "events": [
        {"event": "pre", "turn": "t4", "tool": "apply_patch", "command": "$PATCH", "id": "impact-change"},
        {"event": "post", "turn": "t4", "tool": "apply_patch", "command": "$PATCH", "id": "impact-change"},
        {"event": "write-verification", "turn": "t4", "id": "impact-claims"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "npm test", "id": "impact-check"},
        {"event": "post", "turn": "t4", "tool": "Bash", "command": "npm test", "id": "impact-check"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard verified result=passed how=command", "id": "impact-verified"},
        {"event": "raw-receipt", "turn": "t4", "command": "pmnm-guard done audit=passed", "id": "impact-stale-done"}
      ],
      "expect": {"decision": "deny", "phase": "VERIFY", "contains": "Impact incomplete"}
    },
    {
      "id": "AO-124",
      "class": "advisory-deliverable",
      "claim": "A paired advisory deliverable and boundary can reach human agreement without a fictitious file or state objective.",
      "setup": "configured-advisory",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-plan", "turn": "t3", "text": "- [ ] deliverable: review — evidence-backed review of the requested contract\n- [ ] boundary: review — strongest plausible alternative tested and dispositioned\n"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard digest"}
      ],
      "expect": {"decision": "control", "phase": "AWAITING_HUMAN", "contains": "waiting for the human"}
    },
    {
      "id": "AO-125",
      "class": "proactive-capability",
      "claim": "An already agreed capability can classify one matching unknown operation before its first denial.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "write-plan", "turn": "t3", "text": "- [x] state: reusable-inspection — absent => approved\n"},
        {"event": "write-permissions", "turn": "t3", "value": {"project": [{"capability": "runtime-inspection", "effect": "investigation", "boundary": "local-environment", "persistence": "none", "shape": "inspect bounded local runtime state", "constraints": "read-only and no external transmission", "reason": "reuse an agreed inspection boundary"}]}},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard digest"},
        {"event": "prompt", "turn": "t4", "text": "Agreed exactly as shown"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard agreed"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard declare effect=investigation boundary=local-environment persistence=none certainty=certain capability=runtime-inspection"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "unfamiliar-runtime inspect", "id": "capability-operation"}
      ],
      "expect": {"decision": "silent", "phase": "READY"}
    },
    {
      "id": "AO-126",
      "class": "non-mutating-verification",
      "claim": "A declared non-persistent verification follows the read path and does not manufacture a project mutation.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "pre", "turn": "t3", "tool": "Bash", "command": "unfamiliar-check inspect", "id": "check-first"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard declare effect=verification boundary=project persistence=none certainty=certain capability=none"},
        {"event": "pre", "turn": "t3", "tool": "Bash", "command": "unfamiliar-check inspect", "id": "check-retry"},
        {"event": "post", "turn": "t3", "tool": "Bash", "command": "unfamiliar-check inspect", "id": "check-retry"}
      ],
      "expect": {"decision": "silent", "phase": "INVESTIGATE"}
    },
    {
      "id": "AO-127",
      "class": "proactive-plain-intent",
      "claim": "A plain same-turn declaration can classify exactly the next otherwise-unknown ordinary operation before its first denial.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard declare effect=investigation boundary=project persistence=none certainty=certain capability=none"},
        {"event": "pre", "turn": "t3", "tool": "Bash", "command": "new-tool inspect --format=json", "id": "proactive-plain-operation"}
      ],
      "expect": {"decision": "silent", "phase": "INVESTIGATE"}
    },
    {
      "id": "AO-128",
      "class": "stale-intent-expiry",
      "claim": "A later human turn expires unused proactive intent before another operation can inherit it.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard declare effect=investigation boundary=project persistence=none certainty=certain capability=none"},
        {"event": "prompt", "turn": "t4", "text": "Change direction before running that"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "new-tool inspect --format=json", "id": "stale-intent-operation"}
      ],
      "expect": {"decision": "deny", "phase": "INVESTIGATE", "contains": "declare effect="}
    },
    {
      "id": "AO-129",
      "class": "missing-result",
      "claim": "A declaration cannot overtake a pending host result and the card names result reconciliation.",
      "setup": "agreed",
      "events": [
        {"event": "pre", "turn": "t4", "tool": "apply_patch", "command": "$PATCH", "id": "pending-before-declare"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard declare effect=investigation boundary=project persistence=none certainty=certain capability=none", "id": "declare-with-pending"}
      ],
      "expect": {"decision": "deny", "phase": "READY", "contains": "pmnm-guard result outcome="}
    },
    {
      "id": "AO-130",
      "class": "verification-close",
      "claim": "A blocked audit records its disposition while leaving final human acceptance unarmed.",
      "setup": "agreed",
      "events": [
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard done audit=blocked", "id": "blocked-audit"}
      ],
      "expect": {"decision": "control", "phase": "VERIFY", "contains": "audit is blocked"}
    },
    {
      "id": "AO-131",
      "class": "verification-close",
      "claim": "A bounded current transcript handoff can recover an omitted Stop transition and complete only after the later human prompt.",
      "setup": "armed-test-digest",
      "events": [
        {"event": "prompt-transcript", "turn": "t5", "text": "The handoff is clear; continue to the final audit"},
        {"event": "receipt", "turn": "t5", "command": "pmnm-guard done audit=passed", "id": "transcript-recovered-done"}
      ],
      "expect": {"decision": "control", "phase": "COMPLETE", "contains": "closed, audit passed"}
    },
    {
      "id": "AO-132",
      "class": "operation-admission",
      "claim": "One exact sensitive operation keeps its classification while separate human authority is obtained, then consumes both only on admission.",
      "setup": "configured",
      "events": [
        {"event": "mkdir-task"},
        {"event": "receipt", "turn": "t3", "command": "pmnm-guard declare effect=investigation boundary=local-environment persistence=none certainty=certain capability=none", "id": "proactive-sensitive-declare"},
        {"event": "pre", "turn": "t3", "tool": "Bash", "command": "opaque-runtime inspect", "id": "proactive-sensitive-operation"},
        {"event": "prompt", "turn": "t4", "text": "$APPROVAL_TOKEN"},
        {"event": "receipt", "turn": "t4", "command": "pmnm-guard allow effect=environment", "id": "proactive-sensitive-allow"},
        {"event": "pre", "turn": "t4", "tool": "Bash", "command": "opaque-runtime inspect", "id": "proactive-sensitive-retry"},
        {"event": "post", "turn": "t4", "tool": "Bash", "command": "opaque-runtime inspect", "id": "proactive-sensitive-retry"}
      ],
      "expect": {"decision": "silent", "phase": "INVESTIGATE"}
    }
  ]
}
