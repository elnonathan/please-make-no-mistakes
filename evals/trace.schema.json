{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Please, Make No Mistakes ordered evaluation trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_revision",
    "case_id",
    "client",
    "session",
    "requirements",
    "events",
    "outcome",
    "violations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill_revision": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "effort", "tool_access"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "tool_access": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "source_state"],
      "properties": {
        "clean": {"type": "boolean"},
        "source_state": {"type": "string", "minLength": 1},
        "loaded_skill_digest": {"type": "string", "minLength": 1}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_change",
        "required_references",
        "required_tools",
        "regression_protection"
      ],
      "properties": {
        "material_change": {"type": "boolean"},
        "required_references": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required_tools": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "regression_protection": {"type": "boolean"},
        "identified_activity": {"type": "boolean"},
        "observable_equivalence": {"type": "boolean"},
        "asynchronous_delivery": {"type": "boolean"},
        "effect_scope": {"type": "boolean"},
        "correction_recovery": {"type": "boolean"},
        "decision_alignment": {"type": "boolean"},
        "scenario_coverage": {"type": "boolean"},
        "observable_verification": {"type": "boolean"},
        "epistemic_reconciliation": {"type": "boolean"},
        "canonical_reconciliation": {"type": "boolean"},
        "capability_routing": {"type": "boolean"},
        "tool_evidence_routing": {"type": "boolean"},
        "changed_artifact_diagnostics": {"type": "boolean"}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "residual_risk"],
      "properties": {
        "status": {
          "enum": ["completed", "partial", "blocked", "failed"]
        },
        "summary": {"type": "string", "minLength": 1},
        "residual_risk": {"type": "string"}
      }
    },
    "violations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "type", "status", "evidence", "data"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "type": {
          "enum": [
            "skill-activation",
            "skill-load",
            "context-bootstrap",
            "capability-route",
            "activity-transition",
            "durable-gate-trigger",
            "reference-load",
            "adapter-resolution",
            "tool-invocation",
            "tool-fallback",
            "diagnostic-coverage",
            "provisional-understanding",
            "scenario-seed",
            "evidence-backed-understanding",
            "material-investigation",
            "decision-alignment",
            "scenario-coverage",
            "readiness",
            "readiness-invalidation",
            "recovery",
            "durable-capture",
            "implementation-mutation-attempt",
            "implementation-mutation",
            "verification",
            "verification-disposition",
            "regression-protection",
            "final-audit",
            "report"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "reported",
            "passed",
            "failed",
            "blocked",
            "unavailable",
            "invalidated",
            "denied",
            "allowed",
            "applied",
            "partial",
            "not-run"
          ]
        },
        "evidence": {"type": "string", "minLength": 1},
        "data": {"type": "object"}
      }
    }
  }
}
