{
  "description": "Please, Make No Mistakes destructive-operation brake for Codex.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pmnm-brake.mjs\" --host codex",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\pmnm-brake.mjs\" --host codex",
            "timeout": 45,
            "statusMessage": "Please, Make No Mistakes: checking the operation",
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pmnm-brake.mjs\" --host codex",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\pmnm-brake.mjs\" --host codex",
            "timeout": 10,
            "additionalContextLimit": 600
          }
        ]
      }
    ]
  }
}
